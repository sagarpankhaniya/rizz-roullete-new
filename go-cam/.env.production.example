# Go.cam production environment
# Copy to .env on the production host and replace placeholder values.
# Official source: https://github.com/Godotcam/goCamOpenSource

HTTP_SERVER_PROTOCOL="https"
HTTP_SERVER_HOST="age.example.com"
HTTP_SERVER_PORT=3300

# MUST be exactly 32 characters (AES-256-CBC).
# Generate with: openssl rand -hex 16
# Use this SAME key as cipherKey in your NestJS backend SDK.
ENCRYPTION_KEY="REPLACE_WITH_32_CHAR_SECRET_KEY_!!"
ENCRYPTION_ALGORITHM="aes-256-cbc"

ENABLE_FRONTEND_DEBUG=false
