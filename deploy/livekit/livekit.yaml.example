# Template — install.sh copies this to livekit.yaml and injects keys.
# Do not put real secrets in this file.

port: 7880

bind_addresses:
  - 127.0.0.1
  - "::1"

redis:
  address: 127.0.0.1:6379
  db: 1

rtc:
  port_range_start: 50000
  port_range_end: 60000
  tcp_port: 7881
  use_external_ip: true

keys:
  __LIVEKIT_API_KEY__: __LIVEKIT_API_SECRET__

logging:
  level: info
  pion_level: error
  json: false
  sample: true

room:
  auto_create: false
  empty_timeout: 300
  departure_timeout: 20
  max_participants: 2
  enabled_codecs:
    - mime: audio/opus
    - mime: video/vp8
    - mime: video/h264
