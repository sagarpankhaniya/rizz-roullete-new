# NestJS server
PORT=3001
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Brevo (free tier — https://www.brevo.com) — 300 emails/day
# Create API key: SMTP & API → API Keys
# Verify sender: Senders → Add a sender
BREVO_API_KEY=
MAIL_FROM=Rizz <you@example.com>

# MongoDB
MONGODB_URI=mongodb://localhost:27017/rizz-routlet

# Redis (shared presence + waiting queue; also used by Socket.IO adapter)
REDIS_URL=redis://127.0.0.1:6379
# Or discrete settings (used when REDIS_URL is unset):
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
REDIS_KEY_PREFIX=rizz:

# Self-hosted LiveKit (NOT LiveKit Cloud)
# LIVEKIT_URL  — WebSocket URL clients use to connect (wss:// or ws://)
# LIVEKIT_HOST — HTTP API host used by the server SDK for room management
LIVEKIT_URL=ws://your-livekit-host:7880
LIVEKIT_HOST=http://your-livekit-host:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM_EMPTY_TIMEOUT=300
LIVEKIT_MAX_PARTICIPANTS=2
LIVEKIT_TOKEN_TTL=2h
