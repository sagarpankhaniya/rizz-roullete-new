# NestJS server
# Age verification (Go.cam) is skipped unless NODE_ENV=production
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth (same client ID as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=128875252757-3t3i5ao7tf0r0r954u80qii6n78sjfs2.apps.googleusercontent.com

# Brevo (free tier — https://www.brevo.com) — 300 emails/day
# Create API key: SMTP & API → API Keys
# Verify sender: Senders → Add a sender
BREVO_API_KEY=
MAIL_FROM=Rizz <shahvishwash@gmail.com>
ADMIN_UNBAN_EMAIL=u8jknkhkh@yopmail.com

# Python AI inference service
AI_SERVICE_URL=http://127.0.0.1:8000
AI_GENDER_CONFIDENCE_THRESHOLD=0.60

# Official self-hosted Go.cam age verification (/go-cam)
# ENCRYPTION_KEY in go-cam/.env MUST match GO_CAM_CIPHER_KEY
GO_CAM_BASE_URL=http://localhost:3300
# On HTTPS (ngrok), Nest auto-uses https://<origin>/go-cam-avs via the Vite proxy.
# Override if needed:
# GO_CAM_PUBLIC_URL=https://your-host/go-cam-avs
GO_CAM_CIPHER_KEY=zIkmW2zEgzlTLTRC5xeMbcOhHcE5sBHB
GO_CAM_CALLBACK_URL=http://localhost:3001/api/age-verification/callback

# MongoDB
MONGODB_URI=mongodb://localhost:27017/rizz-routlet

# Redis (shared presence + waiting queue; also used by Socket.IO adapter)
REDIS_URL=redis://127.0.0.1:6379
# Or discrete settings (used when REDIS_URL is unset):
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
REDIS_KEY_PREFIX=rizz:

# Socket.IO — longer timeouts help mobile tabs stay connected during calls
# SOCKET_PING_TIMEOUT_MS=60000
# SOCKET_PING_INTERVAL_MS=25000
# Seconds to wait for socket reconnect before ending an active call
# CALL_DISCONNECT_GRACE_SEC=30

# ---------------------------------------------------------------------------
# Self-hosted LiveKit (Ubuntu VPS) — NOT LiveKit Cloud
# Configure URL + credentials here to match /etc/livekit/livekit.yaml on the VPS.
# See deploy/livekit/README.md for native install (systemd + Nginx, no Docker).
#
# Production (after DNS + Certbot):
#   LIVEKIT_URL=wss://livekit.your-domain.com
# Local smoke against a tunnel / same host:
#   LIVEKIT_URL=ws://127.0.0.1:7880
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://livekit.YOUR_DOMAIN
# Copy LIVEKIT_API_KEY / LIVEKIT_API_SECRET from deploy/livekit/credentials.env
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM_EMPTY_TIMEOUT=300
LIVEKIT_MAX_PARTICIPANTS=2
# Shared roulette pool — one persistent SFU room for all matchers (high participant cap)
LIVEKIT_POOL_ROOM=match-pool
LIVEKIT_POOL_MAX_PARTICIPANTS=500
LIVEKIT_TOKEN_TTL=2h

# ---------------------------------------------------------------------------
# Azure AI Translator — in-call chat translation (server-side only)
# Keys from Azure Portal → your Translator resource → Keys and Endpoint
# NEVER commit real keys or expose them in frontend code.
# ---------------------------------------------------------------------------
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=northeurope
# Optional — defaults to the global cognitive endpoint:
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
