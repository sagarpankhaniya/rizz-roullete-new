APP_NAME=Rizz Routlet AI Service
APP_ENV=development
LOG_LEVEL=INFO

# InsightFace looks for models under <MODEL_ROOT>/models/<MODEL_NAME>.
MODEL_ROOT=.
MODEL_NAME=buffalo_l
MODEL_PROVIDERS=["CPUExecutionProvider"]
MODEL_CONTEXT_ID=-1
DETECTION_WIDTH=640
DETECTION_HEIGHT=640

# Keep false in commercial deployments. Supply model weights whose license
# explicitly permits your use instead of downloading InsightFace's research-only weights.
ALLOW_MODEL_DOWNLOAD=false

MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
